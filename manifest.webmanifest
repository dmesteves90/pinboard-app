{
  "name": "Pinboard",
  "short_name": "Pinboard",
  "description": "Personal notes, lists and drawings on an infinite canvas.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#17181b",
  "theme_color": "#3b6ef5",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "images", "accept": ["image/*"] }]
    }
  }
}
